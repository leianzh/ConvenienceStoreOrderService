@model ConvenienceStoreOrderService.Models.DTOs.ShipmentCreateDto

@{
    ViewBag.Title = "填寫物流資料";
}
<div id="countdownAlert" class="alert alert-warning text-center text-danger">
    請在15分鐘內填寫物流資料，逾時系統將自動取消訂單：
    <strong id="countdown">計算中...</strong>
</div>

<div class="container mt-4">

    <h2 class="mb-3">填寫物流資料</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    <div class="card">
        <div class="card-header">
            物流資料
        </div>

        <div class="card-body">

            @using (Html.BeginForm("FillShipmentInfo", "Orders", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.OrderId)

                <div class="mb-3">
                    <label class="form-label">收件人姓名</label>
                    @Html.TextBoxFor(
                        m => m.RecipientName,
                        new
                        {
                            @class = "form-control",
                            placeholder = "請輸入收件人姓名",
                            required = "required"
                        }
                    )
                </div>

                <div class="mb-3">
                    <label class="form-label">收件人電話</label>
                    @Html.TextBoxFor(
                        m => m.RecipientPhone,
                        new
                        {
                            @class = "form-control",
                            placeholder = "請輸入收件人電話",
                            required = "required"
                        }
                    )
                </div>

                <div class="mb-3">
                    <label class="form-label">取貨門市</label>
                    @Html.TextBoxFor(
                        m => m.PickupStore,
                        new
                        {
                            @class = "form-control",
                            placeholder = "請輸入取貨門市",
                            required = "required"
                        }
                    )
                </div>

                <div class="mb-3">
                    <label class="form-label">賣家姓名</label>
                    @Html.TextBoxFor(
                        m => m.SenderName,
                        new
                        {
                            @class = "form-control bg-light text-muted",
                            @readonly = "readonly",

                        }
                    )
                </div>

                <div class="mb-3">
                    <label class="form-label">賣家電話</label>
                    @Html.TextBoxFor(
                        m => m.SenderPhone,
                        new
                        {
                            @class = "form-control bg-light text-muted",
                            @readonly = "readonly",
                            
                        }
                        
                    )
                </div>


                <div class="mb-3">
                    <label class="form-label">賣家退貨門市</label>
                    @Html.TextBox(
                    "ReturnStoreDisplay",
                    "板橋門市",
                    new
                    {
                        @class = "form-control",
                        disabled = "disabled"

                    })
                    @Html.Hidden("ReturnStore", "板橋門市")
                   
                </div>

                <button type="submit" class="btn btn-primary">
                    確認物流資料
                </button>

                @*<a href="@Url.Action("List", "Orders")"
                   class="btn btn-outline-secondary ms-2">
                    返回訂單列表
                </a>*@
                <a href="@Url.Action("List", "Products")"
                   class="btn btn-outline-secondary ms-2">
                    返回商品頁
                </a>
            }
        </div>

    </div>
</div>
@section scripts {
    <script>
        // 使用後端資料庫的 InfoDueAt，去計算 15 分鐘倒數
        const dueAtText = '@(Model.InfoDueAt.HasValue
    ? Model.InfoDueAt.Value.ToString("yyyy-MM-ddTHH:mm:ss")
    : "")';

        const dueAt = dueAtText ? new Date(dueAtText).getTime() : null;

        const countdownElement = document.getElementById("countdown");
        const countdownAlert = document.getElementById("countdownAlert");
        const submitButton = document.querySelector('button[type="submit"]');
        let timer = null;
        function updateCountdown() {
            const now = new Date().getTime();
            const remainingMilliseconds = dueAt - now;

            if (remainingMilliseconds <= 0) {
                countdownElement.textContent = "已逾時";
                countdownAlert.classList.remove("alert-warning");
                countdownAlert.classList.add("alert-danger");

                submitButton.disabled = true;
                submitButton.textContent = "填寫時間已結束";

                if (timer !== null) {
                    clearInterval(timer);
                }
                return;
            }

            const totalSeconds = Math.floor(remainingMilliseconds / 1000);
            const minutes = Math.floor(totalSeconds / 60);
            const seconds = totalSeconds % 60;

            countdownElement.textContent =
                minutes.toString().padStart(2, "0") +
                ":" +
                seconds.toString().padStart(2, "0");
        }

        updateCountdown();

        timer = setInterval(updateCountdown, 1000);
    </script>
}
